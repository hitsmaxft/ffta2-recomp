set(CMAKE_SYSTEM_NAME Windows)
set(FFTA2_WINDOWS_ARCH x86_64 CACHE STRING "Windows target: x86_64 or aarch64")
set(CMAKE_SYSTEM_PROCESSOR "${FFTA2_WINDOWS_ARCH}")
set(LLVM_MINGW_ROOT "$ENV{LLVM_MINGW_ROOT}" CACHE PATH "Extracted llvm-mingw toolchain")
if(NOT EXISTS "${LLVM_MINGW_ROOT}/bin/${FFTA2_WINDOWS_ARCH}-w64-mingw32-clang")
    message(FATAL_ERROR "Set LLVM_MINGW_ROOT to a macOS/Linux llvm-mingw toolchain")
endif()
set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/${FFTA2_WINDOWS_ARCH}-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/${FFTA2_WINDOWS_ARCH}-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/${FFTA2_WINDOWS_ARCH}-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/${FFTA2_WINDOWS_ARCH}-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
